@page "/documents"
@attribute [Authorize(Policy = "Employee")]
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Documents - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h1>Documents</h1><p class="text-muted mb-0">Upload and manage your authorized files.</p></div>
        <a class="btn btn-outline-primary" href="/documents/shared"><i class="bi bi-share me-1"></i>Shared with me</a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5">Upload documents</h2>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label" for="document-title">Title</label><input id="document-title" class="form-control" @bind="request.Title" /></div>
                <div class="col-md-6"><label class="form-label" for="document-category">Category</label><select id="document-category" class="form-select" @bind="request.Category"><option value="">Select a category</option>@foreach (var category in DocumentCategories.All) { <option value="@category">@category</option> }</select></div>
                <div class="col-md-6"><label class="form-label" for="document-description">Description</label><textarea id="document-description" class="form-control" @bind="request.Description"></textarea></div>
                <div class="col-md-6"><label class="form-label" for="document-tags">Tags</label><input id="document-tags" class="form-control" @bind="request.Tags" /></div>
                <div class="col-12"><label class="form-label" for="document-files">Files</label><InputFile id="document-files" OnChange="HandleFiles" multiple /></div>
                <div class="col-12"><button class="btn btn-primary" @onclick="Upload" disabled="@(selectedFiles.Count == 0 || uploading)"><i class="bi bi-upload me-1"></i>@(uploading ? "Uploading..." : "Upload")</button></div>
            </div>
            @if (results.Count > 0) { <div class="mt-3" aria-live="polite">@foreach (var result in results) { <div class="alert @(result.Success ? "alert-success" : "alert-danger") mb-2"><strong>@result.FileName</strong>: @result.Message</div> }</div> }
        </div>
    </div>

    <div class="d-flex gap-2 align-items-end mb-3 flex-wrap">
        <div><label class="form-label" for="document-search">Search</label><input id="document-search" class="form-control" @bind="query.Search" @bind:event="oninput" /></div>
        <div><label class="form-label" for="document-filter">Category</label><select id="document-filter" class="form-select" @bind="query.Category"><option value="">All categories</option>@foreach (var category in DocumentCategories.All) { <option value="@category">@category</option> }</select></div>
        <button class="btn btn-outline-secondary" @onclick="LoadDocuments"><i class="bi bi-search me-1"></i>Search</button>
    </div>
    @if (documents == null) { <p>Loading documents...</p> }
    else if (documents.Count == 0) { <div class="alert alert-light border">No authorized documents match the current filters.</div> }
    else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Title</th><th>Category</th><th>Uploaded</th><th>Size</th><th>Project</th><th></th></tr></thead><tbody>@foreach (var document in documents) { <tr><td>@document.Title<br /><small class="text-muted">@document.OriginalFileName</small></td><td>@document.Category</td><td>@document.UploadedDate.ToLocalTime().ToString("g")</td><td>@FormatSize(document.FileSize)</td><td>@document.Project?.Name</td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/documents/@document.DocumentId/preview" target="_blank" title="Preview"><i class="bi bi-eye"></i></a> <a class="btn btn-sm btn-outline-primary" href="/documents/@document.DocumentId/download" title="Download"><i class="bi bi-download"></i></a></td></tr> }</tbody></table></div> }
</div>

@code {
    private readonly DocumentUploadRequest request = new();
    private readonly DocumentQuery query = new();
    private IReadOnlyList<IBrowserFile> selectedFiles = Array.Empty<IBrowserFile>();
    private List<DocumentUploadResult> results = new();
    private List<Document>? documents;
    private int userId;
    private bool uploading;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        int.TryParse(state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out userId);
        await LoadDocuments();
    }

    private void HandleFiles(InputFileChangeEventArgs args) => selectedFiles = args.GetMultipleFiles(100);
    private async Task Upload()
    {
        uploading = true; results = (await DocumentService.UploadAsync(selectedFiles, request, userId)).ToList(); uploading = false; selectedFiles = Array.Empty<IBrowserFile>(); await LoadDocuments();
    }
    private async Task LoadDocuments() => documents = await DocumentService.GetDocumentsAsync(userId, query);
    private static string FormatSize(long bytes) => bytes < 1024 * 1024 ? $"{bytes / 1024d:0.#} KB" : $"{bytes / 1024d / 1024d:0.##} MB";
}